yond the opposite edge and begins a fresh, independent pass. */\r\n@keyframes lagom-sky-mid-crossing {\r\n  0% { transform:translate3d(62vw,-.35vh,0) scale(1.006) rotate(-.08deg); }\r\n  97.67%, 100% { transform:translate3d(-112vw,.45vh,0) scale(1.012) rotate(.04deg); }\r\n}\r\n\r\n@keyframes lagom-sky-near-crossing {\r\n  0% { transform:translate3d(-60vw,.55vh,0) scale(1.012) rotate(.08deg); }\r\n  97.26%, 100% { transform:translate3d(118vw,-.45vh,0) scale(1.022) rotate(-.05deg); }\r\n}\r\n\r\n@keyframes lagom-sky-left-crossing {\r\n  0% { transform:translate3d(-38vw,.2vh,0) scale(1.005) rotate(-.06deg); }\r\n  97.94%, 100% { transform:translate3d(112vw,-.3vh,0) scale(1.012) rotate(.04deg); }\r\n}\r\n\r\n@keyframes lagom-sky-right-crossing {\r\n  0% { transform:translate3d(42vw,-.25vh,0) scale(1.005) rotate(.05deg); }\r\n  97.47%, 100% { transform:translate3d(-112vw,.35vh,0) scale(1.012) rotate(-.03deg); }\r\n}\r\n\r\n.sky-home__atmosphere { position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none; }\r\n.sky-home__cloud { position:absolute; display:block; background-repeat:no-repeat; background-position:center; background-size:contain; will-change:transform; }\r\n.sky-home__cloud--mid { top:clamp(70px,8vh,110px); right:-9%; width:clamp(720px,58vw,1160px); height:clamp(390px,32vw,640px); opacity:.76; background-image:url('/src/assets/atmosphere/clouds/cloud-17.webp'); filter:contrast(1.18) brightness(.94) saturate(.9); animation:lagom-sky-mid-crossing 86s cubic-bezier(.42,.05,.58,.95) infinite -31s; }\r\n.sky-home__cloud--near { top:clamp(420px,52vh,570px); left:-13%; width:clamp(760px,61vw,1220px); height:clamp(430px,36vw,720px); opacity:.7; background-image:url('/src/assets/atmosphere/clouds/cloud-21.webp'); filter:contrast(1.2) brightness(.93) saturate(.9); animation:lagom-sky-near-crossing 73s cubic-bezier(.42,.05,.58,.95) infinite -47s; }\r\n.sky-home__cloud--left { top:clamp(520px,64vh,690px); left:-6%; width:clamp(390px,32vw,650px); height:clamp(230px,19vw,390px); opacity:.54; background-image:url('/src/assets/atmosphere/clouds/cloud-09.webp'); filter:contrast(1.16) brightness(.95) saturate(.9); animation:lagom-sky-left-crossing 97s cubic-bezier(.42,.05,.58,.95) infinite -64s; }\r\n.sky-home__cloud--right { top:clamp(250px,31vh,350px); right:-5%; width:clamp(450px,36vw,720px); height:clamp(265px,21vw,430px); opacity:.58; background-image:url('/src/assets/atmosphere/clouds/cloud-19.webp'); filter:contrast(1.16) brightness(.95) saturate(.9); animation:lagom-sky-right-crossing 79s cubic-bezier(.42,.05,.58,.95) infinite -18s; }\r\n\r\n/* Mirror the hero's depth wrappers, pointer response, and crossing timelines. */\r\n.sky-home__cloud-depth { position:absolute; inset:0; display:block; will-change:transform; transition:transform 900ms cubic-bezier(.22,1,.36,1); }\r\n.sky-home__cloud-depth--mid { transform:translate3d(var(--sky-mid-x,0px),var(--sky-mid-y,0px),0); }\r\n.sky-home__cloud-depth--near { transform:translate3d(var(--sky-near-x,0px),var(--sky-near-y,0px),0); }\r\n.sky-home__cloud-depth--left { transform:translate3d(var(--sky-left-x,0px),var(--sky-left-y,0px),0); }\r\n.sky-home__cloud-depth--right { transform:translate3d(var(--sky-right-x,0px),var(--sky-right-y,0px),0); }\r\n\r\n/* Page-level cloud banks continue beneath the isolated hero. They provide the\r\n   long-scroll atmospheric baseline; section-local clouds then layer in as\r\n   their scroll choreography becomes active. */\r\n.sky-home::before,\r\n.sky-home::after {\r\n  display:none;\r\n}\r\n\r\n/* Legacy root cloud banks are intentionally disabled. Post-hero atmosphere is\r\n   now owned by direct section cloud images, avoiding three competing cloud\r\n   render paths and the faded bands they created. */\r\n.sky-home::before,\r\n.sky-home::after {\r\n  position: absolute;\r\n  z-index: 0;\r\n  width: min(1050px, 78vw);\r\n  height: 620px;\r\n  background: center / contain no-repeat url('/src/assets/atmosphere/clouds/cloud-17.webp');\r\n 