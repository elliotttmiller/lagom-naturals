nsition:background-color 180ms ease,transform 180ms ease!important}\r\n  .merch-detail .merch-detail-copy .primary-bar:hover{background:#29463a!important}\r\n  .merch-detail .merch-detail-copy .detail-row{min-height:68px!important;border-top:1px solid #d8d5cc!important;color:#151712!important;font:700 14px/1 var(--font-ui)!important}\r\n  .merch-detail .merch-detail-copy .detail-row:last-child{border-bottom:1px solid #d8d5cc!important}\r\n}\r\n\r\n/* Mobile beverage PDPs use the same full-frame media contract. This intentionally\r\n   supersedes the legacy contain rule, which left product art inset or mis-scaled\r\n   depending on each source image's native aspect ratio. */\r\n@media(max-width:899px){\r\n  /* Merch detail uses a visual wrapper around the main stage and thumbnail rail.\r\n     Keep that wrapper edge-to-edge; only its controls and the adjacent product\r\n     information receive gutters. This prevents apparel imagery from inheriting\r\n     content padding or desktop gallery geometry on phones. */\r\n  .merch-detail .merch-detail-visual{\r\n    inline-size:100vw!important;\r\n    max-inline-size:100vw!important;\r\n    margin-inline:calc(50% - 50vw)!important;\r\n    padding:0!important;\r\n    background:#fff!important;\r\n  }\r\n  .merch-detail .merch-detail-media{\r\n    position:relative!important;\r\n    display:grid!important;\r\n    place-items:center!important;\r\n    inline-size:100%!important;\r\n    height:auto!important;\r\n    min-height:0!important;\r\n    max-height:none!important;\r\n    margin:0!important;\r\n    padding:0!important;\r\n    aspect-ratio:1/1!important;\r\n    overflow:hidden!important;\r\n    border:0!important;\r\n    border-radius:0!important;\r\n    background:#fff!important;\r\n  }\r\n  .merch-detail .merch-detail-media>img{\r\n    display:block!important;\r\n    inline-size:100%!important;\r\n    block-size:100%!important;\r\n    min-inline-size:0!important;\r\n    min-block-size:0!important;\r\n    max-inline-size:none!important;\r\n    max-block-size:none!important;\r\n    margin:0!important;\r\n    padding:clamp(10px,3%,18px)!important;\r\n    object-fit:contain!important;\r\n    object-position:center!important;\r\n  }\r\n  .merch-detail .merch-gallery{\r\n    display:flex!important;\r\n    align-items:center!important;\r\n    gap:9px!important;\r\n    inline-size:100%!important;\r\n    min-height:84px!important;\r\n    margin:0!important;\r\n    padding:10px var(--m-gutter) 16px!important;\r\n    overflow-x:auto!important;\r\n    overscroll-behavior-inline:contain!important;\r\n    scroll-padding-inline:var(--m-gutter)!important;\r\n    background:#fff!important;\r\n    -webkit-overflow-scrolling:touch!important;\r\n  }\r\n  .merch-detail .merch-gallery button{\r\n    position:relative!important;\r\n    display:block!important;\r\n    flex:0 0 62px!important;\r\n    inline-size:62px!important;\r\n    block-size:62px!important;\r\n    padding:0!important;\r\n    overflow:hidden!important;\r\n    border:1px solid rgba(18,22,18,.13)!important;\r\n    border-radius:9px!important;\r\n    background:#fff!important;\r\n    box-shadow:none!important;\r\n  }\r\n  .merch-detail .merch-gallery button.active{border-color:#171a17!important;box-shadow:0 0 0 1px #171a17!important}\r\n  .merch-detail .merch-gallery button:focus-visible{outline:2px solid #171a17!important;outline-offset:2px!important}\r\n  .merch-detail .merch-gallery img{display:block!important;inline-size:100%!important;block-size:100%!important;margin:0!important;padding:5px!important;object-fit:contain!important;object-position:center!important}\r\n\r\n  /* Mobile product gallery stage. Product media keeps its native square frame\r\n     and remains centered without crop or synthetic zoom. */\r\n  .pdp .pdp-media{position:relative!important;display:grid!important;place-items:center!important;inline-size:100vw!important;max-inline-size:100vw!important;height:auto!important;min-height:0!important;max-height:none!important;margin-inline:calc(50% - 50vw)!important;aspect-ratio:1/1!important;isolation:isolate!important;overflow:hidden!important;border:0!important;border-radius:0!important;background:color-mix(in srgb,var(--accent,#c8cbc4) 18%,#f4f3ef)!important}\r\n  .pdp .pdp-media::before{content:\"\";position:absolute;z-index:-2;inset:-28px;background:var(--pdp-image) center/cover no-repeat;filter:blur(24px) saturate(.76) brightness(.96);opacity:.55;transform:scale(1.1)}\r\n  .pdp .pdp-media::after{content:\"\";position:absolute;z-index:-1;inset:0;background:radial-gradient(circle at center,transparent 42%,rgba(255,255,255,.12) 100%);pointer-events:none}\r\n  .pdp .pdp-media>img{position:relative!important;z-index:0!important;display:block!important;width:100%!important;height:100%!important;min-width:0!important;min-height:0!important;max-width:100%!important;max-height:100%!important;margin:0!important;padding:0!important;object-fit:contain!important;object-position:center center!important;transform:none!important;image-rendering:auto!important}\r\n  .pdp .product-gallery{display:flex!important;align-items:center!important;gap:9px!important;min-height:78px!important;margin:0!important;padding:10px var(--m-gutter)!important;background:#fff!important;border-bottom:1px solid rgba(18,22,18,.08)!important;scroll-padding-inline:var(--m-gutter)!important}\r\n  .pdp .product-gallery button{position:relative!important;display:block!important;flex:0 0 58px!important;width:58px!important;height:58px!important;padding:0!important;overflow:hidden!important;border:1px solid rgba(18,22,18,.12)!important;border-radius:9px!important;background:#f4f3ef!important;box-shadow:none!important}\r\n  .pdp .product-gallery button::after{content:\"\";position:absolute;inset:0;border:2px solid transparent;border-radius:inherit;pointer-events:none}\r\n  .pdp .product-gallery button.active{border-color:#1b1d1a!important;box-shadow:none!important}\r\n  .pdp .product-gallery button.active::after{border-color