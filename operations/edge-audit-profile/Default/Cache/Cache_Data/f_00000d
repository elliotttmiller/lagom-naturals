osition: 50% 52% }\r\n.hero-gradient { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(to bottom, rgb(5 10 7 / 0) 34%, rgb(5 10 7 / .05) 47%, rgb(5 10 7 / .26) 62%, rgb(5 10 7 / .62) 82%, rgb(5 10 7 / .72) 100%) }\r\n.hero-blur { position: absolute; left: 0; right: 0; bottom: 0; height: 56px; z-index: 2; pointer-events: none; backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.18) 30%, rgba(0,0,0,.72) 74%, #000 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,.18) 30%, rgba(0,0,0,.72) 74%, #000 100%) }\r\n.hero-surface-fade { position: absolute; left: 0; right: 0; bottom: -1px; height: 76px; z-index: 2; pointer-events: none; background: linear-gradient(to bottom, rgb(248 247 243 / 0) 0%, rgb(248 247 243 / .03) 18%, rgb(248 247 243 / .10) 34%, rgb(248 247 243 / .28) 52%, rgb(248 247 243 / .58) 72%, rgb(248 247 243 / .86) 88%, var(--surface-warm) 100%) }\r\n.hero-copy { position: absolute; left: 14px; right: 14px; bottom: 40px; z-index: 3; max-width: 320px; color: #fff }\r\n.hero-copy > p { margin: 0 0 5px; font: 700 8.5px/1.2 var(--font-ui); letter-spacing: .09em; opacity: .92 }\r\n.hero-copy h1 { font: 400 clamp(36px, 10vw, 42px)/.89 var(--font-display); letter-spacing: -.035em; margin: 0; max-width: 260px; color: #fff }\r\n.hero-copy > span { display: block; max-width: 300px; font: 400 11px/1.32 var(--font-primary); letter-spacing: -.005em; opacity: .92; margin-top: 7px }\r\n.hero-actions { display: grid; grid-template-columns: 1.05fr .95fr; gap: 7px; margin-top: 10px; width: min(100%, 300px) }\r\n.hero-actions a { min-height: 38px; border-radius: 4px; display: flex; align-items: center; justify-content: center; gap: 5px; font: 700 8.5px/1 var(--font-ui); letter-spacing: .015em; padding-inline: 11px }\r\n.hero-actions a:first-child { background: var(--green); color: #fff; box-shadow: 0 3px 12px rgba(5,55,39,.24) 