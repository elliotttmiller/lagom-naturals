: .025em; display: flex; align-items: center; justify-content: center }\r\n.linkbar { margin-top: 12px }\r\n\r\n/* ─── MERCH ──────────────────────────────────────────────────────────────── */\r\n.merch-head { text-align: center; padding: 8px 0 12px }\r\n.merch-head h1 { font: 400 clamp(26px, 7vw, 34px)/1 var(--font-display); margin: 0 }\r\n.merch-head p { font: 400 11px/1.3 var(--font-primary); color: var(--muted); margin: 6px 0 0 }\r\n.merch-chips { margin-bottom: 10px }\r\n.merch-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px }\r\n.merch-grid > div { min-width: 0; height: 100% }\r\n.merch-grid > div > .merch-card { height: 100% }\r\n.merch-card { min-width: 0; border: 1px solid var(--line); border-radius: 6px; overflow: hidden }\r\n.merch-card > a { display: block; color: inherit; height: 100% }\r\n.merch-media { height: clamp(180px, 50vw, 240px); background: var(--surface-soft); position: relative }\r\n.merch-media img { width: 100%; height: 100%; object-fit: contain; padding: 6px }\r\n.merch-media svg { position: absolute; right: 7px; top: 7px; width: 16px }\r\n.merch-card > a > p { font: 600 9px/1.2 var(--font-primary); color: var(--muted); margin: 7px 9px 2px }\r\n.merch-card > a > h3 { font: 700 12px/1.15 var(--font-primary); letter-spacing: -.02em; margin: 0 9px }\r\n.merch-card > a > b { display: block; font: 800 15px/1 var(--font-primary); letter-spacing: -.02em; margin: 5px 9px }\r\n.merch-card > a > .swatches { margin: 4px 9px 8px }\r\n.swatches { display: flex; gap: 5px }\r\n.swatches i { width: 10px; height: 10px; border-radius: 50%; background: #2f2a25 }\r\n.swatches i:nth-child(2) { background: #d7c7ad }\r\n.swatches i:nth-child(3) { background: #0d3f31 }\r\n.swatches i:nth-child(4) { background: #f5f5f2; border: 1px solid #bbb }\r\n.swatches.large i { width: 18px; height: 18px }\r\n\r\n.merch-detail { padding: 0 18px 28px; max-width: none }\r\n.merch-detail-media { height: clamp(300px, 80vw, 380px); background: var(--surface-soft); margin: 0 -18px 10px; display: grid; place-items: center }\r\n.merch-detail-media img { width: 100%; height: 100%; object-fit: contain; padding: 8px }\r\n.merch-detail > div:not(.merch-detail-media) > p { font: 600 10px/1.2 var(--font-primary); color: var(--muted); margin: 0 }\r\n.merch-detail h1 { font: 400 clamp(26px, 7vw, 34px)/1 var(--font-display); margin: 4px 0 4px }\r\n.merch-detail h2 { font: 700 18px/1 var(--font-primary); letter-spacing: -.02em; margin: 0 0 12px }\r\n.option-line { display: flex; align-items: center; gap: 8px; margin: 8px 0 }\r\n.option-line > b { font: 700 10px/1 var(--font-primary) }\r\n.detail-row { height: 38px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; font: 600 10px/1 var(--font-primary) }\r\n.detail-row svg { width: 14px }\r\n\r\n/* ─── CART ───────────────────────────────────────────────────────────────── */\r\n.cart-page h1, .checkout-page h1 { font: 400 clamp(26px, 7vw, 34px)/1 var(--font-display); margin: 4px 0 14px }\r\n.cart-page h1 span { font-size: .72em; color: var(--muted) }\r\n.cart-list { border-top: 1px solid var(--line) }\r\n.cart-row { display: grid; grid-template-columns: 62px 1fr auto; grid-template-rows: auto auto; column-gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); position: relative }\r\n.cart-row > img { grid-row: 1/3; width: 62px; height: 62px; object-fit: contain; background: var(--surface-soft); border-radius: 5px }\r\n.cart-item-copy p { font: 600 9px/1.2 var(--font-primary); color: var(--muted); margin: 0 }\r\n.cart-item-copy b { font: 700 12px/1.2 var(--font-primary); letter-spacing: -.015em; display: block }\r\n.cart-item-copy small { font: 500 9px/1.2 var(--font-primary); color: var(--muted) }\r\n.cart-row > strong { font: 700 12px/1 var(--font-primary); padding-right: 3px }\r\n.cart-qty { display: flex; align-items: center; align-self: end; justify-self: end; border: 1px solid var(--line-strong); border-radius: 4px; overflow: hidden }\r\n.cart-qty button { width: 26px; height: 24px; border: 0; background: #fff; display: grid; place-items: center }\r\n.cart-qty button svg { width: 11px }\r\n.cart-qty span { min-width: 22px; text-align: center; font: 700 9px/1 var(--font-primary) }\r\n.remove { position: absolute; right: 0; bottom: 12px; transform: translateX(18px); border: 0; background: transparent; font-size: 15px; color: var(--muted) }\r\n.cart-page textarea { width: 100%; height: 52px; resize: none; border: 1px solid var(--line-strong); border-radius: 5px; padding: 9px; margin-top: 10px; font: 500 11px/1.4 var(--font-primary) }\r\n.totals { padding: 8px 0; border-bottom: 1px solid var(--line) }\r\n.totals p, .pickup-row { display: flex; justify-content: space-between; margin: 5px 0; font: 500 10px/1 var(--font-primary) }\r\n.pickup-row { align-items: center; padding: 10px 0 }\r\n.pickup-row span { display: flex; flex-direction: column }\r\n.pickup-row small { font-size: 8px; color: var(--muted); margin-top: 2px }\r\n.pickup-row button { border: 0; background: transparent; color: var(--green); font: 600 9px/1 var(--font-primary) }\r\n\r\n/* ─── CHECKOUT ───────────────────────────────────────────────────────────── */\r\n.checkout-steps { display: flex; align-items: center; margin-bottom: 16px }\r\n.checkout-steps span { display: flex; align-items: center; gap: 4px; font: 600 8px/1 var(--font-primary); color: var(--muted) }\r\n.checkout-steps span.active { color: var(--green); font-weight: 700 }\r\n.checkout-steps i { height: 1px; flex: 1; background: var(--line); margin: 0 6px }\r\n.checkout-page h2 { font: 400 16px/1 var(--font-display); margin: 14px 0 8px }\r\n.checkout-step > label:not(.checkbox) { display: flex; flex-direction: column; font: 600 9px/1.2 var(--font-primary); border: 1px solid var(--line-strong); border-radius: 5px; padding: 6px 8px }\r\n.checkout-step > label:not(.checkbox) input { border: 0; outline: 0; font: 500 12px/1 var(--font-primary); background: transparent; margin-top: 3px }\r\n.checkout-step > .checkbox { display: flex; align-items: center; gap: 6px; border: 0; padding: 0; font: 500 10px/1 var(--font-primary); margin: 10px 0 }\r\n.checkbox input { accent-color: var(--green) }\r\n.method-card { height: 48px; border: 1px solid var(--line); border-radius: 5px; display: flex; align-items: center; gap: 9px; padding: 0 10px; margin-bottom: 5px; background: var(--surface-soft) }\r\n.method-card.active { border-color: #9fb8ae; background: #f8fbf9 }\r\n.method-card svg { width: 17px; color: var(--green) }\r\n.method-card span, .pickup-card span { display: flex; flex-direction: column }\r\n.method-card b, .pickup-card b { font: 700 10px/1 var(--font-primary) }\r\n.method-card small, .pickup-card small { font: 500 9px/1 var(--font-primary); color: var(--muted) }\r\n.pickup-card { border: 1px solid var(--line); border-radius: 5px; background: var(--surface-soft); display: flex; align-items: center; justify-content: space-between; padding: 9px 10px; margin-bottom: 14px }\r\n.pickup-card a, .pickup-card button { border: 0; background: transparent; color: var(--green); font: 600 9px/1 var(--font-primary) }\r\n.muted { font: 400 11px/1.4 var(--font-primary); color: var(--muted) }\r\n.checkout-step { min-width: 0 }\r\n\r\n/* ─── ACCOUNT ────────────────────────────────────────────────────────────── */\r\n.account-page { padding-top: 18px }\r\n.account-welcome { display: flex; align-items: center; gap: 14px; padding: 8px 0 18px; border-bottom: 1px solid var(--line) }\r\n.leaf-mark { font: 400 44px/1 var(--font-display); width: 46px; color: var(--green) }\r\n.account-welcome p { font: 500 12px/1 var(--font-primary); color: var(--muted); margin: 0 0 4px }\r\n.account-welcome h1 { font: 400 30px/.95 var(--font-display); margin: 0 }\r\n.account-rows { margin-top: 4px }\r\n.account-rows > div { min-width: 0 }\r\n.account-rows > div > button { width: 100% }\r\n.account-rows button { width: 100%; min-height: 54px; border: 0; border-bottom: 1px solid var(--line); background: #fff; display: grid; grid-template-columns: 22px 1fr 18px; align-items: center; text-align: left; padding: 0 3px; font: 600 12px/1.2 var(--font-primary); color: var(--ink); gap: 10px }\r\n.account-rows button svg:first-child { width: 16px; color: var(--green); stroke-width: 1.8 }\r\n.account-rows button svg:last-child { width: 16px; color: var(--muted) }\r\n.account-rows .reward-row { min-height: 56px; background: var(--green-soft); border-radius: 5px; margin: 8px 0; border-bottom: 0 }\r\n.reward-row span { display: flex; flex-direction: column }\r\n.reward-row b { font: 700 11px/1 var(--font-primary); color: var(--green) }\r\n.reward-row small { font: 500 9px/1 var(--font-primary); color: var(--muted) }\r\n\r\n/* ─── VISIT ──────────────────────────────────────────────────────────────── */\r\n.visit-page { min-height: calc(100vh - 120px); background: var(--surface-soft) }\r\n.visit-photo { height: 230px }\r\n.visit-photo img { width: 100%; height: 100%; object-fit: cover }\r\n.visit-card { margin: -20px 14px 16px; position: relative; background: #fff; border-radius: 6px; padding: 14px; box-shadow: 0 4px 18px rgba(0,0,0,.08) }\r\n.visit-card > p { font: 700 8px/1 var(--font-ui); letter-spacing: .1em; color: var(--green); margin: 0 0 4px }\r\n.visit-card h1 { font: 400 clamp(28px, 8vw, 36px)/.92 var(--font-display); margin: 0 0 8px }\r\n.visit-card > span { font: 400 11px/1.3 var(--font-primary) }\r\n.visit-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 10px }\r\n.visit-actions a { height: 38px; border-radius: 5px; font: 700 9px/1 var(--font-ui); display: flex; align-items: center; justify-content: center; gap: 5px }\r\n.visit-actions a:first-child { background: var(--green); color: #fff }\r\n.visit-actions a:last-child { border: 1px solid #888; background: #fff }\r\n.visit-actions svg { width: 13px }\r\n.hours { padding: 10px 0; border-bottom: 1px solid var(--line) }\r\n.hours > b { font: 400 14px/1 var(--font-display) }\r\n.hours p { display: flex; justify-content: space-between; font: 400 9px/1 var(--font-primary); margin: 5px 0 }\r\n.hours strong { font-weight: 600 }\r\n.amenities { display: grid; grid-template-columns: repeat(3, 1fr); padding-top: 10px }\r\n.amenities span { text-align: center; font: 500 8px/1.2 var(--font-primary); color: var(--muted) }\r\n\r\n/* ─── ABOUT ──────────────────────────────────────────────────────────────── */\r\n.about-page { padding-bottom: 28px }\r\n.about-page > img:first-child { width: calc(100% + 36px); max-width: none; height: 260px; object-fit: cover; margin: 0 -18px 18px }\r\n.about-page h1 { font: 400 clamp(32px, 8vw, 48px)/.92 var(--font-display); margin: 0 0 12px }\r\n.about-page > p { font: 400 12px/1.55 var(--font-primary); color: var(--muted) }\r\n.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin: 16px 0 }\r\n.about-grid img { height: 150px; width: 100%; object-fit: cover; border-radius: 4px }\r\n.about-page > img:last-child { width: 100%; height: 240px; object-fit: cover; border-radius: 4px }\r\n\r\n/* ─── FOOTER ─────────────────────────────────────────────────────────────── */\r\n.site-footer { background: #111713; color: #fff; margin-top: 48px; padding: 44px max(20px, env(safe-area-inset-left)) calc(28px + env(safe-area-inset-bottom)) }\r\n.site-footer__inner { width: 100%; max-width: 1600px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 28px 18px }\r\n.site-footer__brand { grid-column: 1 / -1 }\r\n.site-footer__brand img { width: 110px; filter: invert(1) }\r\n.site-footer__brand p { max-width: 320px; color: #b9c0bb; font: 400 12px/1.6 var(--font-primary); margin: 14px 0 0 }\r\n.site-footer__inner > div { display: flex; flex-direction: column; gap: 9px }\r\n.site-footer h4 { font: 700 9px/1 var(--font-ui); letter-spacing: .12em; text-transform: uppercase; color: #aeb6b0; margin: 0 0 4px }\r\n.site-footer a, .site-footer span { font: 400 11px/1.45 va