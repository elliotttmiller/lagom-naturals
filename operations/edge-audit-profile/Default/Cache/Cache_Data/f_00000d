letter-spacing: -.015em }\r\n.originals-banner svg { width: 16px }\r\n\r\n/* ─── LISTING PAGE ───────────────────────────────────────────────────────── */\r\n.listing-page h1 { font: 400 clamp(26px, 7vw, 34px)/1 var(--font-display); margin: 4px 0 12px }\r\n.listing-page h1 span { font-size: .72em; font-weight: 400; color: var(--muted) }\r\n.filter-row { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-bottom: 9px }\r\n.filter-row button { height: 36px; background: #fff; border: 1px solid var(--line-strong); border-radius: 5px; font: 600 10px/1 var(--font-primary); color: var(--ink-soft); display: flex; align-items: center; justify-content: center; gap: 5px }\r\n.filter-row svg { width: 13px }\r\n.chips { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin-bottom: 10px }\r\n.chips::-webkit-scrollbar { display: none }\r\n.chips button { border: 0; background: var(--surface-soft); border-radius: 999px; min-height: 30px; padding: 0 13px; font: 600 9px/1 var(--font-primary); white-space: nowrap; color: var(--muted) }\r\n.chips button.active { background: var(--green); color: #fff }\r\n.listing-grid { gap: 7px }\r\n.listing-grid .product-media { height: clamp(150px, 42vw, 200px) }\r\n\r\n/* ─── PDP ────────────────────────────────────────────────────────────────── */\r\n.pdp { max-width: none; margin: 0 }\r\n.pdp-media { height: clamp(280px, 78vw, 360px); background: linear-gradient(145deg, #f7f7f4, #f0f2ee); display: grid; place-items: center; position: relative; padding: 20px }\r\n.pdp-media img { width: 100%; height: 100%; object-fit: contain }\r\n.pdp-dots { position: absolute; bottom: 8px; left: 0; right: 0; display: flex; justify-content: center; gap: 5px }\r\n.pdp-dots i { width: 4px; height: 4px; border-radius: 50%; background: #b9b9b5 }\r\n.pdp-dots i.active { background: #424640 }\r\n.pdp-copy { padding: 14px 18px 28px }\r\n.pdp-copy > p:first-child { font: 600 10px/1.2 var(--font-primary); color: var(--muted); margin: 0 }\r\n