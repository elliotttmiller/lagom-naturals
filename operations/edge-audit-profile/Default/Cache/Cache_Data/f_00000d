adding-top:clamp(56px,10.2vh,104px)!important;\r\n}\r\n\r\n.age-gate__brand img{\r\n  display:block!important;\r\n  width:clamp(200px,53vw,286px)!important;\r\n  height:auto!important;\r\n  margin:0!important;\r\n  object-fit:contain!important;\r\n  filter:brightness(0) invert(1)!important;\r\n  transform:none!important;\r\n}\r\n\r\n.age-gate__content{\r\n  width:min(100%,500px)!important;\r\n  margin:0 auto!important;\r\n  padding:0 0 clamp(12px,1.8vh,24px)!important;\r\n  display:flex!important;\r\n  flex-direction:column!important;\r\n  align-items:center!important;\r\n  flex:0 0 auto!important;\r\n}\r\n\r\n.age-gate__eyebrow{\r\n  width:100%!important;\r\n  margin:0 0 clamp(10px,1.6vh,16px)!important;\r\n  color:#fff!important;\r\n  font:800 clamp(9px,2.55vw,12px)/1 var(--font-ui,var(--sans,sans-serif))!important;\r\n  letter-spacing:.31em!important;\r\n  text-transform:uppercase!important;\r\n  white-space:nowrap!important;\r\n  text-align:center!important;\r\n  text-shadow:\r\n    0 2px 5px rgba(0,0,0,.78),\r\n    0 1px 16px rgba(0,0,0,.48)!important;\r\n}\r\n\r\n.age-gate__content h1{\r\n  width:100%!important;\r\n  margin:0!important;\r\n  color:#fffdf8!important;\r\n  font:400 clamp(52px,14.8vw,72px)/.86 var(--font-display,var(--serif,Georgia,serif))!important;\r\n  letter-spacing:-.06em!important;\r\n  text-align:center!important;\r\n  text-wrap:balance!important;\r\n  text-shadow:\r\n    0 3px 8px rgba(0,0,0,.72),\r\n    0 2px 26px rgba(0,0,0,.42)!important;\r\n}\r\n\r\n.age-gate__copy{\r\n  width:min(100%,430px)!important;\r\n  margin:clamp(17px,2.2vh,23px) auto 0!important;\r\n  color:var(--age-muted)!important;\r\n  font:500 clamp(13px,3.65vw,16px)/1.45 var(--font-primary,var(--sans,sans-serif))!important;\r\n  letter-spacing:-.008em!important;\r\n  text-align:center!important;\r\n  text-shadow:\r\n    0 2px 5px rgba(0,0,0,.80),\r\n    0 1px 15px rgba(0,0,0,.48)!important;\r\n}\r\n\r\n.age-gate__actions{\r\n  width:min(100%,438px)!important;\r\n  margin:clamp(24px,3.2vh,32px) auto 0!important;\r\n  display:grid!important;\r\n  gap:clamp(11px,1.5vh,15px)!important;\r\n}\r\n\r\n.age-gate__action{\r\n  position:relative!important;\r\n  isolation:isolate!important;\r\n  width:100%!important;\r\n  min-height:clamp(64px,8.3vh,76px)!important;\r\n  margin:0!important;\r\n  padding:0 26px!important;\r\n  display:flex!important;\r\n  align-items:center!important;\r\n  justify-content:center!important;\r\n  gap:12px!important;\r\n  overflow:hidden!important;\r\n  appearance:none!important;\r\n  border:1px solid var(--age-glass-border)!important;\r\n  border-radius:20px!important;\r\n  background:rgba(255,255,255,.09)!important;\r\n  color:#fff!important;\r\n  box-shadow:\r\n    inset 0 1px 0 rgba(255,255,255,.23),\r\n    inset 0 -1px 0 rgba(255,255,255,.05),\r\n    0 10px 26px rgba(0,0,0,.16)!important;\r\n  -webkit-backdrop-filter:blur(18px) saturate(1.16)!important;\r\n  backdrop-filter:blur(18px) saturate(1.16)!important;\r\n  font:800 clamp(11px,3vw,13px)/1 var(--font-ui,var(--sans,sans-serif))!important;\r\n  letter-spacing:.18em!important;\r\n  text-transform:uppercase!important;\r\n  text-shadow:0 2px 5px rgba(0,0,0,.48)!important;\r\n  transition:\r\n    transform .2s ease,\r\n    background-color .2s ease,\r\n    border-color .2s ease,\r\n    box-shadow .2s ease!important;\r\n}\r\n\r\n.age-gate__action::before{\r\n  content:\"\";\r\n  position:absolute;\r\n  inset:0;\r\n  z-index:-1;\r\n  pointer-events:none;\r\n  border-radius:inherit;\r\n  background:\r\n    radial-gradient(circle at 18% 0%,rgba(255,255,255,.15),transparent 42%),\r\n    linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.01) 64%,transparent);\r\n}\r\n\r\n.age-gate__action--primary{\r\n  border-color:rgba(255,255,255,.72)!important;\r\n  background:rgba(255,255,255,.13)!important;\r\n}\r\n\r\n.age-gate__action--secondary{\r\n  border-color:rgba(255,255,255,.46)!important;\r\n  background:rgba(9,12,9,.18)!important;\r\n}\r\n\r\n.age-gat