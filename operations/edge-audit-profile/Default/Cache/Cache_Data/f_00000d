:none!important;\r\n  }\r\n\r\n  /* Keep the complete merch gallery together while product information scrolls.\r\n     The former sticky main image left its thumbnail rail behind in document\r\n     flow, so the selected view and its controls separated during scrolling. */\r\n  .merch-detail .merch-detail-visual{\r\n    position:sticky!important;\r\n    top:calc(var(--desktop-header-h, 88px) + var(--desktop-announcement-h, 0px) + 22px)!important;\r\n    align-self:start!important;\r\n    min-width:0!important;\r\n  }\r\n  .merch-detail .merch-detail-media{\r\n    position:relative!important;\r\n    top:auto!important;\r\n    display:grid!important;\r\n    place-items:center!important;\r\n    inline-size:100%!important;\r\n    grid-column:2!important;\r\n    grid-row:1!important;\r\n    block-size:min(720px,calc(100svh - var(--desktop-header-h, 88px) - var(--desktop-announcement-h, 0px) - 112px))!important;\r\n    min-block-size:500px!important;\r\n    margin:0!important;\r\n    padding:0!important;\r\n    overflow:hidden!important;\r\n    border:0!important;\r\n    border-radius:0!important;\r\n    background:#fff!important;\r\n  }\r\n  .merch-detail .merch-detail-media>img{\r\n    display:block!important;\r\n    inline-size:100%!important;\r\n    block-size:100%!important;\r\n    min-inline-size:0!important;\r\n    min-block-size:0!important;\r\n    max-inline-size:none!important;\r\n    max-block-size:none!important;\r\n    margin:0!important;\r\n    /* Preserve a small, even safety area for tightly framed apparel sources.\r\n       The prior zero inset let the lower hem meet and slightly clip at the\r\n       viewport boundary despite the centered contain fit. */\r\n    padding:clamp(16px,2.2%,28px)!important;\r\n    object-fit:contain!important;\r\n    object-position:center!important;\r\n    transform:none!important;\r\n    transform-origin:center!important;\r\n  }\r\n  .merch-detail .merch-gallery{\r\n    grid-column:1!important;\r\n    grid-row:1!important;\