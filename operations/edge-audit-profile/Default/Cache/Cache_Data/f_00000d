erage-hero__copy>p{font-size:16px}.hero-actions a{min-height:50px;padding:0 20px;font-size:10px}\r\n  .drink-grid,.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}\r\n  .category-grid{grid-template-columns:repeat(3,minmax(0,1fr))}\r\n  .merch-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\r\n  .intro-band{grid-template-columns:1fr 1.45fr;gap:34px}.intro-band>div{grid-column:2}.intro-band>p{grid-row:1 / span 2}\r\n  .pdp,.merch-detail{grid-template-columns:minmax(0,1fr) minmax(380px,.9fr);gap:42px}\r\n  .cart-row{grid-template-columns:96px minmax(0,1fr) 110px 136px 28px;gap:16px}.cart-row>img{width:96px;height:82px}\r\n  .find-page{grid-template-columns:minmax(360px,.85fr) minmax(0,1.15fr);gap:44px}.find-page>img{height:560px}\r\n}\r\n\r\n/* Large desktop */\r\n@media (min-width:1600px){\r\n  :root{--desktop-header-h:94px}\r\n  .desktop-nav__brand{width:176px;height:72px}.desktop-nav__brand img{width:170px;height:62px}\r\n  .desktop-nav a:not(.desktop-nav__brand){font-size:12px}.header-tools .icon-btn{width:50px;height:50px;min-width:50px}.header-tools .icon-btn svg{width:24px;height:24px}\r\n  .beverage-hero__copy{width:min(620px,38vw)}.beverage-hero h1{font-size:clamp(88px,6.4vw,124px)}\r\n  .product-copy h3,.merch-card h3{font-size:19px}.product-copy>b,.merch-card>b,.merch-card a>b{font-size:19px}\r\n}\r\n\r\n/* Shop uses the storefront's true white canvas, matching the product and merch routes. */\r\n@media (min-width:900px){\r\n  body:has(.shop-page),\r\n  .app-shell:has(.shop-page),\r\n  .app-shell:has(.shop-page)>main,\r\n  .shop-page{background:#fff!important}\r\n}\r\n/* Lagom Naturals age gate — approved mockup implementation.\r\n   Full-screen photographic gate with centered editorial typography and\r\n   dedicated liquid-glass actions. */\r\n\r\nbody.age-gate-open{\r\n  overflow:hidden!important;\r\n  overscroll-behavior:none!important;\r\n  touch-action:none;\r\n}\r\n\r\n.age-gate{\r\n  --age-ink:#fffdf8;\r\n  --age-muted:rgba(255,255,255,