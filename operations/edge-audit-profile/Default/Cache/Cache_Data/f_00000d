\n    padding:0!important;\r\n    display:grid!important;\r\n    place-items:center!important;\r\n    overflow:hidden!important;\r\n    background:#fff!important;\r\n  }\r\n  .catalog-card__media>a{display:grid!important;place-items:center!important;width:100%!important;height:100%!important;overflow:hidden!important}\r\n  .catalog-card__media img{display:block!important;width:100%!important;height:100%!important;max-width:100%!important;max-height:100%!important;margin:0!important;padding:0!important;background:transparent!important;object-fit:contain!important;object-position:center center!important;transform:none!important}\r\n}\r\n\r\n/* Shared storefront product-card contract: beverages, gummies, and merch use\r\n   one card anatomy while their product-specific purchasing controls remain. */\r\n.unified-product-card{\r\n  min-width:0;\r\n  height:100%;\r\n  display:flex;\r\n  flex-direction:column;\r\n  overflow:hidden;\r\n  border:1px solid rgba(31,35,31,.12);\r\n  border-radius:16px;\r\n  background:#fff;\r\n  box-shadow:0 1px 2px rgba(20,24,20,.03),0 10px 30px rgba(20,24,20,.035);\r\n  transition:border-color 180ms ease,box-shadow 180ms ease;\r\n}\n\n.unified-product-card:hover{border-color:rgba(31,35,31,.2);box-shadow:0 2px 4px rgba(20,24,20,.04),0 18px 42px rgba(20,24,20,.075)}\n.unified-product-card__media{position:relative;display:grid;place-items:center;width:100%;aspect-ratio:1/1.02;border:0;border-bottom:1px solid rgba(31,35,31,.1);border-radius:15px 15px 0 0;background:#fff;overflow:hidden}\r\n.unified-product-card__media>a{display:grid;place-items:center;width:100%;height:100%;overflow:hidden;background:#fff}\r\n.unified-product-card__media picture{display:contents}\r\n.unified-product-card__media img{display:block;width:100%;height:100%;object-fit:contain;object-position:center;background:#fff;transition:transform 280ms ease}\r\n.unified-product-card:hover .unified-product-card__media img{transform:scale(1.025)}\r\n.unified-product-card .heart-btn{